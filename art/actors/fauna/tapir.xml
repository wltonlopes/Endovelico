<?xml version="1.0" encoding="utf-8"?>
<!-- Tapir dos mapas (gaia/fauna_tapir). A malha tapir.dae tinha ossos mas nenhum peso;
     tapir.pmd é a mesma malha (3,2 m) no esqueleto do javali, com as animações dele
     (tools/import_fauna_transfer.py, entrada "tapir"). -->
<actor version="1">
  <castshadow/>
  <group>
    <variant file="fauna/tapir.xml" name="Base">
      <mesh>skeletal/fauna/tapir.pmd</mesh>
    </variant>
  </group>
  <group>
    <variant frequency="1" name="Black">
      <textures>
        <texture file="skeletal/animal_tapir_black_and_white.png" name="baseTex"/>
        <texture file="default_norm.png" name="normTex"/>
        <texture file="null_black.dds" name="specTex"/>
      </textures>
    </variant>
  </group>
  <material>no_trans_norm_spec.xml</material>
</actor>
