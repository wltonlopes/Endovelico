<?xml version="1.0" encoding="utf-8"?>
<!-- Brilho do fogo (luz falsa): halo aditivo grande que pisca em volta da chama.
     O motor não tem luzes dinâmicas; isto imita a iluminação. -->
<particles>

    <texture>art/textures/particles/fire_glow.png</texture>
    <blend mode="add"/>

    <start_full/>

    <constant name="emissionrate" value="8.0"/>
    <uniform name="lifetime" min="0.5" max="0.9"/>

    <uniform name="angle" min="-3.14" max="3.14"/>

    <uniform name="velocity.x" min="-0.05" max="0.05"/>
    <uniform name="velocity.y" min="0.05" max="0.25"/>
    <uniform name="velocity.z" min="-0.05" max="0.05"/>

    <uniform name="size" min="5" max="7.5"/>

    <uniform name="color.r" min="0.075" max="0.120"/>
    <uniform name="color.g" min="0.035" max="0.060"/>
    <uniform name="color.b" min="0.008" max="0.016"/>

</particles>
