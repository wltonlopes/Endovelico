				</object>
				<object name="turnsValue" type="text" style="ModernLabelText" size="220 150 320 182"/>

				<object type="text" style="ModernLabelText" size="40 190 220 222">
					<translatableAttribute id="caption">Gold earned</translatableAttribute>
				</object>
				<object name="goldValue" type="text" style="ModernLabelText" size="220 190 320 222"/>

				<object type="text" style="ModernLabelText" size="40 230 220 262">
