				<object type="text" style="ModernLabelText" size="50%+40 140 100%-40 172">
					<translatableAttribute id="caption">Campaign history</translatableAttribute>
				</object>
				<object name="timelineList" type="list" style="ModernLabelText" size="50%+40 180 100%-40 100%-96"/>

				<object
					name="newCampaignButton"
					type="button"
					style="StoneButtonFancy"
					size="100%-240 100%-40 100% 100%">

